{
  "name": "tabellone-hockey",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "app": "vite build && electron .",
    "app:smoke": "vite build && node scripts/smoke.mjs",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "vite build && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "description": "Tabellone segnapunti per hockey su ghiaccio, funzionante offline",
  "main": "electron/main.cjs",
  "author": "Alessio Polonia",
  "productName": "Tabellone Hockey",
  "homepage": "https://github.com/AEBWP/tabellone-hockey",
  "build": {
    "appId": "it.tabellonehockey.app",
    "productName": "Tabellone Hockey",
    "copyright": "© Alessio Polonia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/*.cjs",
      "electron/splash.html",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Tabellone-Hockey-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tabellone Hockey",
      "language": "1040",
      "installerLanguages": [
        "it_IT"
      ],
      "deleteAppDataOnUninstall": false,
      "artifactName": "Tabellone-Hockey-${version}-installazione.${ext}"
    }
  }
}
